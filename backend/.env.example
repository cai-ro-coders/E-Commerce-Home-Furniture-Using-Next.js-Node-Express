# ============================================================================
#  Backend environment configuration
#  Copy to `.env` and adjust for your environment. Never commit real secrets.
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Public URL of this API (used to build absolute URLs in emails / receipts)
API_URL=http://localhost:4000

# --- MySQL ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecommerce_nextjsDB
DB_CONNECTION_LIMIT=10

# --- Auth -------------------------------------------------------------------
# Generate a real secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_only_change_me_3f8a1c9e7b5d2a4f6c8e0b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a1c3e5b7d9f1
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_DOMAIN=localhost

# CSRF / XSS hardening
CSRF_PROTECTION=true
XSS_SANITIZE=true

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# Public URL of the storefront. Stripe redirects the browser here after
# checkout (success/cancel), so it must be reachable from the customer's browser.
# Defaults to the first CORS origin.
APP_URL=http://localhost:3000

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# --- Payments: Stripe --------------------------------------------------------
# Test keys: https://dashboard.stripe.com/test/apikeys
# Leave blank to use the admin-managed `stripe_secret_key` /
# `stripe_publishable_key` settings instead.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret printed by `stripe listen` (whsec_...). Required only for
# webhook signature verification.
STRIPE_WEBHOOK_SECRET=

# --- Payments: PayPal --------------------------------------------------------
# Sandbox REST app: https://developer.paypal.com/dashboard/applications/sandbox
# Set both, or leave both blank to use the admin-managed `paypal_client_id` /
# `paypal_client_secret` settings.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `sandbox` (default) or `live`.
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID from the PayPal dashboard, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# --- Store defaults (overridable at runtime via the `settings` table) -------
SITE_NAME=Lumera Home
CURRENCY=PHP
TAX_RATE=0.12
SHIPPING_FEE=250

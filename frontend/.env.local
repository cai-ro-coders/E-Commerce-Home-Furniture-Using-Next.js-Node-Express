# Base URL of the Express API. The client appends resource paths to this.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Origin that serves uploaded files (product photos, brand logos, ...).
NEXT_PUBLIC_UPLOADS_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: PayPal client ID for inline Smart Buttons. The redirect checkout
# only needs the backend PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET pair.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
